rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check — requires the 'admin' custom claim set via Firebase Admin SDK.
    // Until custom claims are configured, TPO/admin users are managed via the
    // 'role' field on their Firestore user document (server-side Cloud Functions
    // already enforce logic; these rules prevent direct client-side writes).
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'tpo' ||
        request.auth.token.role == 'admin'
      );
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can update their own doc; admins can update any user doc
      allow write: if isOwner(userId) || isAdmin();

      match /bookmarks/{problemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Problems ─────────────────────────────────────────────────────────
    // All authenticated users can read; only Cloud Functions (admin SDK) or
    // users with an admin claim can write.
    match /problems/{problemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Test Cases ───────────────────────────────────────────────────────
    // Hidden test cases must never be readable by students.
    // Writes are admin-only (seed via Admin SDK or admin user).
    match /testCases/{problemId} {
      allow read: if false;   // Never readable client-side — server only
      allow write: if isAdmin();
    }

    // ── User Progress ────────────────────────────────────────────────────
    match /userProgress/{userId} {
      allow read, write: if isOwner(userId);

      match /problems/{problemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Submissions ──────────────────────────────────────────────────────
    // Students read only their own submissions; admins can read all.
    // Only Cloud Functions (via Admin SDK, bypasses rules) write submissions.
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Clients do NOT write submissions directly — the backend Cloud Function
      // uses the Admin SDK which bypasses these rules.
      allow write: if false;
    }

    // ── Sync Metadata ────────────────────────────────────────────────────
    match /syncMetadata/{metaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
