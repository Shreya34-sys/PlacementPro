rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /problems/{problemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Temporarily open for browser-based initial sync
    }

    match /userProgress/{userId} {
      allow read, write: if isOwner(userId);
      
      match /problems/{problemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable once created (updated only via server if needed)
    }

    match /syncMetadata/{metaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Temporarily open for browser-based initial sync
    }
  }
}
