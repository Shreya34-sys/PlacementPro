# ─────────────────────────────────────────────────────────────────────────────
# PlacementPro — Firebase Cloud Functions environment variables
# Copy this file to functions/.env and fill in your real values.
# NEVER commit functions/.env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Judge0 Code Execution API ─────────────────────────────────────────────────
# Obtain credentials from https://rapidapi.com/judge0-official/api/judge0-ce
# or from your self-hosted Judge0 instance.
#
# For RapidAPI-hosted Judge0 CE:
#   JUDGE0_API_URL  = https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY  = your RapidAPI key
#   JUDGE0_HOST     = judge0-ce.p.rapidapi.com
#
# For a self-hosted Judge0 instance (no host header required):
#   JUDGE0_API_URL  = http://your-server:2358
#   JUDGE0_API_KEY  = your-auth-token (if configured)
#   JUDGE0_HOST     = (leave blank)
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_HOST=

# ── PlacementPro Question Bank (optional) ─────────────────────────────────────
# QUESTION_BANK_API_URL=""
QUESTION_BANK_SYNC_LIMIT="100"
QUESTION_BANK_SYNC_MAX_PAGES="10"
