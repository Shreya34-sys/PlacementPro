PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=ppro
# Remote MySQL SSL (e.g. for TiDB Serverless or cloud MySQL with TLS)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# C-Visualize Isolated Compiler Worker (Docker sandbox control plane)
COMPILER_WORKER_URL=http://127.0.0.1:6060
COMPILER_WORKER_TOKEN=your-random-compiler-worker-token

# Optional: Reverse-proxy to original C-Visualize backend service if run on a dedicated port
ORIGINAL_COMPILER_SERVICE_URL=http://127.0.0.1:5051
